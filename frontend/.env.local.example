# ═══════════════════════════════════════════════════════════════════
# SUDHAN TEXTILE ERP - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local and update with your configuration
#
# NEVER commit .env.local to version control
# It contains sensitive information specific to your environment
#
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# SAMPLE DATA SYSTEM CONFIGURATION
# ───────────────────────────────────────────────────────────────────

# Enable/Disable Fill Sample Data feature globally
# Set to 'true' in Development, Staging, QA, UAT environments
# Set to 'false' in Production
#
# When enabled:
# - ⚡ Fill Sample Data button visible to SuperAdmin/Admin
# - Sample data can be filled in all forms
# - Audit logs will mark records with SAMPLE mode
#
# When disabled:
# - Button hidden from UI
# - Sample data functions blocked
# - Production safety enforced
NEXT_PUBLIC_ENABLE_SAMPLE_DATA=true

# ───────────────────────────────────────────────────────────────────
# API CONFIGURATION
# ───────────────────────────────────────────────────────────────────

# Backend API URL
# Development: http://localhost:5000/api
# Staging: https://staging-api.sudhantextile.com/api
# Production: https://api.sudhantextile.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ───────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ───────────────────────────────────────────────────────────────────

# Database type (used by frontend for feature detection)
# Options: SQLite, SQLServer, PostgreSQL
NEXT_PUBLIC_DB_TYPE=SQLite

# ───────────────────────────────────────────────────────────────────
# ENVIRONMENT TYPE
# ───────────────────────────────────────────────────────────────────

# Current environment
# Options: development, staging, qa, uat, production
NEXT_PUBLIC_ENV=development

# Show debug information
NEXT_PUBLIC_DEBUG=true

# ───────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ───────────────────────────────────────────────────────────────────

# Enable advanced audit logging
NEXT_PUBLIC_ENABLE_AUDIT_LOGGING=true

# Enable stock impact calculations
NEXT_PUBLIC_ENABLE_STOCK_CALCULATIONS=true

# Enable automatic yield calculations (Baby Cone, Sizing)
NEXT_PUBLIC_ENABLE_AUTO_CALCULATIONS=true

# ───────────────────────────────────────────────────────────────────
# USAGE NOTES
# ───────────────────────────────────────────────────────────────────
#
# Development Setup:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Update NEXT_PUBLIC_API_URL if backend runs on different port
# 3. Set NEXT_PUBLIC_ENABLE_SAMPLE_DATA=true
# 4. Restart Next.js dev server
#
# Production Setup:
# 1. Set NEXT_PUBLIC_ENABLE_SAMPLE_DATA=false
# 2. Update API_URL to production endpoint
# 3. Set ENV=production
# 4. Set DEBUG=false
# 5. Review all feature flags
#
# ═══════════════════════════════════════════════════════════════════
