# ════════════════════════════════════════════════════════════════════════════
# SUDHAN TEXTILE ERP — DOCKER ENVIRONMENT VARIABLES
# ════════════════════════════════════════════════════════════════════════════
# 1. Copy this file:  cp .env.docker .env
# 2. Fill in ALL values marked CHANGE_THIS
# 3. NEVER commit .env to source control
# ════════════════════════════════════════════════════════════════════════════

# ── MySQL ────────────────────────────────────────────────────────────────────
# Strong root password (only used by MySQL internally)
MYSQL_ROOT_PASSWORD=CHANGE_THIS_strong_root_password_123!

# App-level DB user (backend connects with this)
MYSQL_USER=erp_user
MYSQL_PASSWORD=CHANGE_THIS_strong_app_password_456!

# ── JWT Secret ───────────────────────────────────────────────────────────────
# Minimum 32 characters required by the backend (256-bit HMAC-SHA256)
# Generate one:  openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_THIS_paste_your_openssl_rand_base64_48_output_here

# ── CORS & API URL ───────────────────────────────────────────────────────────
# Replace with your EC2 public IP or domain name (no trailing slash)
# Examples:
#   http://54.123.45.67
#   https://erp.yourdomain.com  (if you add SSL termination to nginx later)
#
# CORS_ALLOWED_ORIGINS  → sent by the backend; the browser checks this
# NEXT_PUBLIC_API_URL   → baked into the Next.js JS bundle at build time
#                         Must match what the browser actually calls
EC2_HOST=http://CHANGE_THIS_YOUR_EC2_PUBLIC_IP

CORS_ALLOWED_ORIGINS=${EC2_HOST}
NEXT_PUBLIC_API_URL=${EC2_HOST}

# ── Optional: email alerts from the backend ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
