{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "__CONNECTION_STRING_FROM_ENV__",
    "DatabaseProvider": "SQLite",
    "_comment": "Production: Set DB_CONNECTION_STRING environment variable. SQLite for dev only."
  },
  "JwtSettings": {
    "SecretKey": "__JWT_SECRET_FROM_ENV__",
    "Issuer": "SudhanTextileERP",
    "Audience": "SudhanTextileERPUsers",
    "ExpiryMinutes": 120,
    "_comment": "Production: Set JWT_SECRET_KEY environment variable (min 256 bits / 32 chars)"
  },
  "CorsSettings": {
    "AllowedOrigins": ["http://localhost:3000"],
    "_comment": "Production: Set CORS_ALLOWED_ORIGINS environment variable"
  },
  "Security": {
    "RequireHttps": false,
    "EnableRateLimiting": true,
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 30,
    "ForcePasswordChangeOnFirstLogin": true
  },
  "SampleData": {
    "AutoLoad": false,
    "Comment": "NEVER enable AutoLoad in production."
  }
}
