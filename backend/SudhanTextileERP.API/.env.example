# ═══════════════════════════════════════════════════════════════════════════════════
# SUDHAN TEXTILE ERP - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════════════
# IMPORTANT: Copy this file to .env and fill in production values
# NEVER commit .env to source control
# ═══════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────────
# DATABASE CONNECTION (REQUIRED IN PRODUCTION)
# ─────────────────────────────────────────────────────────────────────────────────────
# Format: Server=hostname;Port=3306;Database=dbname;Uid=username;Pwd=password;SslMode=Required;
DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=SudhanTextileERP;Uid=erp_user;Pwd=CHANGE_THIS_PASSWORD;SslMode=Required;

# ─────────────────────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION (REQUIRED IN PRODUCTION)
# ─────────────────────────────────────────────────────────────────────────────────────
# Minimum 32 characters (256 bits) for HMAC-SHA256
# Generate with: openssl rand -base64 32
# Or in .NET: SecureConfigurationLoader.GenerateSecureJwtKey()
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_256_BIT_KEY_MINIMUM_32_CHARS

# ─────────────────────────────────────────────────────────────────────────────────────
# CORS ALLOWED ORIGINS (REQUIRED IN PRODUCTION)
# ─────────────────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# NO localhost in production!
CORS_ALLOWED_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

# ─────────────────────────────────────────────────────────────────────────────────────
# OPTIONAL CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production

# Backup encryption key (optional - for encrypted backups)
BACKUP_ENCRYPTION_KEY=

# Notification email settings (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# ═══════════════════════════════════════════════════════════════════════════════════
# SECURITY NOTES
# ═══════════════════════════════════════════════════════════════════════════════════
# 1. NEVER commit this file with real credentials to source control
# 2. Use different credentials for development, staging, and production
# 3. Rotate JWT_SECRET_KEY periodically (invalidates all existing tokens)
# 4. Use SSL/TLS for all database connections (SslMode=Required)
# 5. Restrict database user permissions to minimum required
# ═══════════════════════════════════════════════════════════════════════════════════
