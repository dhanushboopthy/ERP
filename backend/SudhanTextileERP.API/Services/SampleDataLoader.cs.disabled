    #region Demo Users

    private async Task LoadDemoUsersAsync(SampleDataLoadResult result)
    {
        var demoUsers = new[]
        {
            new { Email = "admin@demo.com", Name = "Demo Admin", Role = "SuperAdmin" },
            new { Email = "manager@demo.com", Name = "Demo Manager", Role = "Manager" },
            new { Email = "operator1@demo.com", Name = "Demo Operator", Role = "Operator" },
            new { Email = "viewer@demo.com", Name = "Demo Viewer", Role = "Viewer" }
        };

        int created = 0;
        foreach (var demoUser in demoUsers)
        {
            var exists = await _context.Users.AnyAsync(u => u.Email == demoUser.Email);
            if (!exists)
            {
                try
                {
                    await _authService.RegisterAsync(new RegisterRequest
                    {
                        Username = demoUser.Email.Split('@')[0],
                        Email = demoUser.Email,
                        Password = "Demo@123",
                        FullName = demoUser.Name
                    });

                    // Assign role
                    var user = await _context.Users.FirstOrDefaultAsync(u => u.Email == demoUser.Email);
                    if (user != null)
                    {
                        var role = await _context.Roles.FirstOrDefaultAsync(r => r.RoleName == demoUser.Role);
                        if (role != null)
                        {
                            user.RoleId = role.Id;
                            user.CreatedBy = DEMO_USER;
                            await _context.SaveChangesAsync();
                        }
                    }
                    created++;
                }
                catch (Exception ex)
                {
                    _logger.LogWarning("Could not create demo user {Email}: {Error}", demoUser.Email, ex.Message);
                }
            }
        }

        result.LoadedCounts["DemoUsers"] = created;
        _logger.LogInformation("Created {Count} demo users", created);
    }

    #endregion

    #region Transactional Data Loaders

    private async Task LoadYarnReceiptsAsync(SampleDataLoadResult result)
    {
        var vendors = await _context.Parties.Where(p => p.PartyType == "Vendor" && p.CreatedBy == DEMO_USER).ToListAsync();
        var yarnCounts = await _context.YarnCounts.Where(y => y.CreatedBy == DEMO_USER).ToListAsync();
        var vehicles = await _context.Vehicles.Where(v => v.CreatedBy == DEMO_USER).ToListAsync();

        if (!vendors.Any() || !yarnCounts.Any()) return;

        var receipts = new[]
        {
            new
            {
                Days = -10,
                VendorIndex = 0,
                YarnIndex = 0,
                LotNo = "LOT-2025-001",
                Bags = 50,
                GrossWeight = 2500m,
                TareWeight = 50m
            },
            new
            {
                Days = -8,
                VendorIndex = 1,
                YarnIndex = 1,
                LotNo = "LOT-2025-002",
                Bags = 40,
                GrossWeight = 2000m,
                TareWeight = 40m
            },
            new
            {
                Days = -5,
                VendorIndex = 0,
                YarnIndex = 2,
                LotNo = "LOT-2025-003",
                Bags = 60,
                GrossWeight = 3000m,
                TareWeight = 60m
            },
            new
            {
                Days = -3,
                VendorIndex = 1,
                YarnIndex = 3,
                LotNo = "LOT-2025-004",
                Bags = 45,
                GrossWeight = 2250m,
                TareWeight = 45m
            },
            new
            {
                Days = -1,
                VendorIndex = 0,
                YarnIndex = 4,
                LotNo = "LOT-2025-005",
                Bags = 55,
                GrossWeight = 2750m,
                TareWeight = 55m
            }
        };

        int count = 0;
        foreach (var rcpt in receipts)
        {
            if (rcpt.VendorIndex >= vendors.Count || rcpt.YarnIndex >= yarnCounts.Count) continue;

            var request = new CreateYarnReceiptRequest
            {
                ReceiptDate = DateTime.Now.AddDays(rcpt.Days),
                PartyId = vendors[rcpt.VendorIndex].Id,
                VehicleId = vehicles.Any() ? vehicles[0].Id : null,
                VehicleNo = vehicles.Any() ? vehicles[0].VehicleNo : null,
                DriverName = vehicles.Any() ? vehicles[0].DriverName : null,
                Remarks = $"Demo receipt - {rcpt.LotNo}",
                Details = new List<YarnReceiptDetailRequest>
                {
                    new()
                    {
                        YarnCountId = yarnCounts[rcpt.YarnIndex].Id,
                        LotNo = rcpt.LotNo,
                        NoOfBags = rcpt.Bags,
                        GrossWeight = rcpt.GrossWeight,
                        TareWeight = rcpt.TareWeight,
                        NetWeight = rcpt.GrossWeight - rcpt.TareWeight,
                        Rate = 150m + (rcpt.YarnIndex * 10),
                        Amount = (rcpt.GrossWeight - rcpt.TareWeight) * (150m + (rcpt.YarnIndex * 10))
                    }
                }
            };

            await _yarnReceiptService.CreateAsync(request, DEMO_USER);
            count++;
        }

        result.LoadedCounts["YarnReceipts"] = count;
        _logger.LogInformation("Created {Count} yarn receipts", count);
    }

    private async Task LoadBabyConesAsync(SampleDataLoadResult result)
    {
        var receipts = await _context.YarnReceipts
            .Include(r => r.Details)
            .Where(r => r.CreatedBy == DEMO_USER)
            .Take(3)
            .ToListAsync();

        int count = 0;
        foreach (var receipt in receipts)
        {
            foreach (var detail in receipt.Details)
            {
                var request = new CreateBabyConeRequest
                {
                    JobDate = receipt.ReceiptDate.AddDays(1),
                    YarnReceiptDetailId = detail.Id,
                    InputCones = 100,
                    InputWeight = detail.NetWeight * 0.8m, // Use 80% of receipt
                    OutputCones = 98,
                    OutputWeight = detail.NetWeight * 0.8m * 0.98m, // 2% loss
                    WastagePercent = 2m,
                    Remarks = "Demo baby cone winding"
                };

                await _babyConeService.CreateAsync(request, DEMO_USER);
                count++;
            }
        }

        result.LoadedCounts["BabyCones"] = count;
        _logger.LogInformation("Created {Count} baby cones", count);
    }

    private async Task LoadWarpingJobCardsAsync(SampleDataLoadResult result)
    {
        var babyCones = await _context.BabyCones
            .Where(b => b.CreatedBy == DEMO_USER)
            .Take(2)
            .ToListAsync();

        var beams = await _context.Beams
            .Where(b => b.Status == BeamStatus.Empty && b.CreatedBy == DEMO_USER)
            .Take(4)
            .ToListAsync();

        if (!babyCones.Any() || beams.Count < 2) return;

        int count = 0;
        for (int i = 0; i < Math.Min(2, babyCones.Count); i++)
        {
            var request = new CreateWarpingJobCardRequest
            {
                JobCardDate = babyCones[i].JobDate.AddDays(1),
                BabyConeId = babyCones[i].Id,
                SetLength = 5000 + (i * 500),
                ActualLength = 4950 + (i * 500),
                Ends = 3200 + (i * 100),
                RPM = 200,
                StartTime = DateTime.Now.AddDays(-5 + i).AddHours(8),
                EndTime = DateTime.Now.AddDays(-5 + i).AddHours(16),
                Breaks = 5 + i,
                Remarks = $"Demo warping job {i + 1}",
                Beams = new List<WarpingJobCardBeamRequest>
                {
                    new() { BeamId = beams[i * 2].Id, BeamWeight = 250m },
                    new() { BeamId = beams[i * 2 + 1].Id, BeamWeight = 245m }
                }
            };

            await _warpingService.CreateAsync(request, DEMO_USER);
            count++;
        }

        result.LoadedCounts["WarpingJobCards"] = count;
        _logger.LogInformation("Created {Count} warping job cards", count);
    }

    private async Task LoadSizingJobCardsAsync(SampleDataLoadResult result)
    {
        var warpingCards = await _context.WarpingJobCards
            .Include(w => w.Beams)
            .Where(w => w.CreatedBy == DEMO_USER)
            .Take(2)
            .ToListAsync();

        var parties = await _context.Parties
            .Where(p => p.PartyType == "Customer" && p.CreatedBy == DEMO_USER)
            .FirstOrDefaultAsync();

        if (!warpingCards.Any() || parties == null) return;

        int count = 0;
        foreach (var warpingCard in warpingCards)
        {
            if (!warpingCard.Beams.Any()) continue;

            var request = new CreateSizingJobCardRequest
            {
                JobCardDate = warpingCard.JobCardDate.AddDays(1),
                PartyId = parties.Id,
                WarpingJobCardId = warpingCard.Id,
                SetLength = warpingCard.SetLength,
                ActualLength = warpingCard.ActualLength,
                PickupPercent = 12.5m,
                ElongationPercent = 2.5m,
                Status = count == 0 ? "Draft" : "Authorized",
                Remarks = $"Demo sizing job {count + 1}",
                Beams = warpingCard.Beams.Select(b => new SizingJobCardBeamRequest
                {
                    BeamId = b.BeamId,
                    BeamWeight = b.BeamWeight
                }).ToList()
            };

            await _sizingService.CreateAsync(request, DEMO_USER);
            count++;
        }

        result.LoadedCounts["SizingJobCards"] = count;
        _logger.LogInformation("Created {Count} sizing job cards", count);
    }

    private async Task LoadYarnReturnsAsync(SampleDataLoadResult result)
    {
        var jobworkParty = await _context.Parties
            .FirstOrDefaultAsync(p => p.PartyType == "Jobwork" && p.CreatedBy == DEMO_USER);

        var yarnCounts = await _context.YarnCounts
            .Where(y => y.CreatedBy == DEMO_USER)
            .FirstOrDefaultAsync();

        if (jobworkParty == null || yarnCounts == null) return;

        var request = new CreateYarnReturnRequest
        {
            ReturnDate = DateTime.Now.AddDays(-2),
            PartyId = jobworkParty.Id,
            IsForSale = false,
            Remarks = "Demo jobwork return - Not for sale",
            Details = new List<YarnReturnDetailRequest>
            {
                new()
                {
                    YarnCountId = yarnCounts.Id,
                    LotNo = "RET-LOT-001",
                    NoOfBags = 10,
                    GrossWeight = 500m,
                    TareWeight = 10m,
                    NetWeight = 490m,
                    Rate = 140m,
                    Amount = 490m * 140m
                }
            }
        };

        await _yarnReturnService.CreateAsync(request, DEMO_USER);
        result.LoadedCounts["YarnReturns"] = 1;
        _logger.LogInformation("Created yarn return");
    }

    private async Task LoadYarnDeliveriesAsync(SampleDataLoadResult result)
    {
        var customers = await _context.Parties
            .Where(p => p.PartyType == "Customer" && p.CreatedBy == DEMO_USER)
            .ToListAsync();

        var yarnCounts = await _context.YarnCounts
            .Where(y => y.CreatedBy == DEMO_USER)
            .Take(2)
            .ToListAsync();

        if (!customers.Any() || !yarnCounts.Any()) return;

        int count = 0;
        for (int i = 0; i < Math.Min(2, customers.Count); i++)
        {
            var request = new CreateYarnDeliveryRequest
            {
                DeliveryDate = DateTime.Now.AddDays(-1 - i),
                PartyId = customers[i].Id,
                IsApproved = true,
                Remarks = $"Demo delivery to {customers[i].PartyName}",
                Details = new List<YarnDeliveryDetailRequest>
                {
                    new()
                    {
                        YarnCountId = yarnCounts[Math.Min(i, yarnCounts.Count - 1)].Id,
                        LotNo = $"DEL-LOT-00{i + 1}",
                        NoOfBags = 20 + (i * 5),
                        GrossWeight = 1000m + (i * 200),
                        TareWeight = 20m + (i * 5),
                        NetWeight = 980m + (i * 195),
                        Rate = 180m + (i * 10),
                        Amount = (980m + (i * 195)) * (180m + (i * 10))
                    }
                }
            };

            await _yarnDeliveryService.CreateAsync(request, DEMO_USER);
            count++;
        }

        result.LoadedCounts["YarnDeliveries"] = count;
        _logger.LogInformation("Created {Count} yarn deliveries", count);
    }

    private async Task LoadInvoicesAsync(SampleDataLoadResult result)
    {
        var sizingCards = await _context.SizingJobCards
            .Include(s => s.Party)
            .Where(s => s.CreatedBy == DEMO_USER && s.Status == "Authorized")
            .ToListAsync();

        if (!sizingCards.Any()) return;

        int count = 0;
        foreach (var sizing in sizingCards)
        {
            var request = new CreateTaxInvoiceRequest
            {
                InvoiceDate = sizing.JobCardDate.AddDays(2),
                PartyId = sizing.PartyId,
                SizingJobCardId = sizing.Id,
                PaymentStatus = count == 0 ? "Paid" : "Pending",
                DueDate = sizing.JobCardDate.AddDays(32),
                Remarks = "Demo GST invoice",
                Details = new List<TaxInvoiceDetailRequest>
                {
                    new()
                    {
                        Description = $"Sizing services for {sizing.SetLength}m",
                        HSNCode = "998821",
                        Quantity = sizing.SetLength,
                        UOM = "Meters",
                        Rate = 2.5m,
                        Amount = sizing.SetLength * 2.5m,
                        SGSTPercent = 9m,
                        CGSTPercent = 9m,
                        IGSTPercent = 0m
                    }
                }
            };

            await _invoiceService.CreateAsync(request, DEMO_USER);
            count++;
        }

        result.LoadedCounts["TaxInvoices"] = count;
        _logger.LogInformation("Created {Count} tax invoices", count);
    }

    #endregion
}
