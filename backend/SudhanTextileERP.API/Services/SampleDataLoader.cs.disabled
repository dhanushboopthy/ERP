    private async Task LoadBeamMasterAsync(SampleDataLoadResult result)
    {
        if (await _context.Beams.AnyAsync()) return;

        var beams = new List<Beam>();
        for (int i = 1; i <= 15; i++)
        {
            beams.Add(new Beam
            {
                BeamNo = $"B-{i:D3}",
                BeamType = i <= 8 ? BeamType.WarpersBeam : (i <= 12 ? BeamType.SizersBeam : BeamType.LoomBeam),
                Status = i == 13 ? BeamStatus.Maintenance : BeamStatus.Empty,
                CreatedBy = DEMO_USER
            });
        }

        _context.Beams.AddRange(beams);
        await _context.SaveChangesAsync();
        result.LoadedCounts["Beams"] = beams.Count;
        _logger.LogInformation("Loaded {Count} beams", beams.Count);
    }

    private async Task LoadFinancialYearAsync(SampleDataLoadResult result)
    {
