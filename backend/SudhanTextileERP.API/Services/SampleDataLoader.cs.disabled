using Microsoft.EntityFrameworkCore;
using SudhanTextileERP.API.Data;
using SudhanTextileERP.API.DTOs;
using SudhanTextileERP.API.Entities;

namespace SudhanTextileERP.API.Services;

public interface ISampleDataLoader
{
    Task<SampleDataLoadResult> LoadDemoDataAsync();
    Task<bool> ClearDemoDataAsync();
    Task<bool> IsDemoDataLoadedAsync();
}

public class SampleDataLoadResult
{
    public bool Success { get; set; }
    public string Message { get; set; } = string.Empty;
    public Dictionary<string, int> LoadedCounts { get; set; } = new();
    public List<string> Errors { get; set; } = new();
}

public class SampleDataLoader : ISampleDataLoader
{
    private readonly ApplicationDbContext _context;
    private readonly IYarnReceiptService _yarnReceiptService;
    private readonly IBabyConeService _babyConeService;
    private readonly IWarpingJobCardService _warpingService;
    private readonly ISizingJobCardService _sizingService;
    private readonly IYarnReturnService _yarnReturnService;
    private readonly IYarnDeliveryService _yarnDeliveryService;
    private readonly IInvoiceService _invoiceService;
    private readonly IAuthService _authService;
    private readonly IWebHostEnvironment _environment;
    private readonly ILogger<SampleDataLoader> _logger;
    private const string DEMO_USER = "SYSTEM_DEMO";

    public SampleDataLoader(
        ApplicationDbContext context,
        IYarnReceiptService yarnReceiptService,
        IBabyConeService babyConeService,
        IWarpingJobCardService warpingService,
        ISizingJobCardService sizingService,
        IYarnReturnService yarnReturnService,
        IYarnDeliveryService yarnDeliveryService,
        IInvoiceService invoiceService,
        IAuthService authService,
        IWebHostEnvironment environment,
        ILogger<SampleDataLoader> logger)
    {
        _context = context;
        _yarnReceiptService = yarnReceiptService;
        _babyConeService = babyConeService;
        _warpingService = warpingService;
        _sizingService = sizingService;
        _yarnReturnService = yarnReturnService;
        _yarnDeliveryService = yarnDeliveryService;
        _invoiceService = invoiceService;
        _authService = authService;
        _environment = environment;
        _logger = logger;
    }

    public async Task<bool> IsDemoDataLoadedAsync()
    {
        return await _context.Parties.AnyAsync(p => p.CreatedBy == DEMO_USER);
    }

    public async Task<SampleDataLoadResult> LoadDemoDataAsync()
    {
        var result = new SampleDataLoadResult();

        // SAFETY CHECK: Only allow in Development or Demo environments
        if (!_environment.IsDevelopment() && 
            !_environment.EnvironmentName.Equals("Demo", StringComparison.OrdinalIgnoreCase))
        {
            result.Success = false;
            result.Message = "Sample data can only be loaded in Development or Demo environments";
            return result;
        }

        // Check if already loaded
        if (await IsDemoDataLoadedAsync())
        {
            result.Success = false;
            result.Message = "Demo data already loaded. Clear existing demo data first.";
            return result;
        }

        try
        {
            _logger.LogInformation("Starting sample data load...");

            // STEP 1: Master Data
            await LoadCompanyMasterAsync(result);
            await LoadYarnCountMasterAsync(result);
            await LoadLoomTypeMasterAsync(result);
            await LoadPartiesMasterAsync(result);
            await LoadVehicleMasterAsync(result);
            await LoadBeamMasterAsync(result);
            await LoadFinancialYearAsync(result);

            // STEP 2: Demo Users
            await LoadDemoUsersAsync(result);

            // STEP 3: Transactional Data (using services)
            await LoadYarnReceiptsAsync(result);
            await LoadBabyConesAsync(result);
            await LoadWarpingJobCardsAsync(result);
            await LoadSizingJobCardsAsync(result);
            await LoadYarnReturnsAsync(result);
            await LoadYarnDeliveriesAsync(result);
            await LoadInvoicesAsync(result);

            result.Success = true;
            result.Message = $"Demo data loaded successfully. Total records: {result.LoadedCounts.Values.Sum()}";
            
            _logger.LogInformation(result.Message);
            return result;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading sample data");
            result.Success = false;
            result.Message = $"Error: {ex.Message}";
            result.Errors.Add(ex.ToString());
            return result;
        }
    }

    public async Task<bool> ClearDemoDataAsync()
    {
        // SAFETY CHECK
        if (!_environment.IsDevelopment() && 
            !_environment.EnvironmentName.Equals("Demo", StringComparison.OrdinalIgnoreCase))
        {
            _logger.LogWarning("Attempted to clear demo data in non-dev environment");
            return false;
        }

        try
        {
            _logger.LogInformation("Clearing demo data...");

            // Delete in reverse order to respect FK constraints
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM TaxInvoiceDetails WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM TaxInvoices WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM YarnDeliveryDetails WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM YarnDeliveries WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM YarnReturnDetails WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM YarnReturns WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM SizingJobCardBeams WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM SizingJobCards WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM WarpingJobCardBeams WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM WarpingJobCards WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM BabyConeDetails WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM BabyCones WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM YarnReceiptDetails WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM YarnReceipts WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM YarnStocks WHERE CreatedBy = {0}", DEMO_USER);
            
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM Users WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM Beams WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM Vehicles WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM Parties WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM LoomTypes WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM YarnCounts WHERE CreatedBy = {0}", DEMO_USER);
            await _context.Database.ExecuteSqlRawAsync("DELETE FROM Companies WHERE CreatedBy = {0}", DEMO_USER);

            _logger.LogInformation("Demo data cleared successfully");
            return true;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error clearing demo data");
            return false;
        }
    }

