        if (currentFY == null)
        {
            var fy = new FinancialYear
            {
                YearCode = "FY2025-26",
                YearName = "FY 2025-2026",
                StartDate = new DateTime(2025, 4, 1),
                EndDate = new DateTime(2026, 3, 31),
                IsCurrent = true,
                CreatedBy = DEMO_USER
            };
            _context.FinancialYears.Add(fy);
            await _context.SaveChangesAsync();
            result.LoadedCounts["FinancialYears"] = 1;
            _logger.LogInformation("Created financial year");
        }
    }

